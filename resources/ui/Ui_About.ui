  <property name="styleSheet">
   <string notr="true">QDialog#About {
    background: #F5F7FB;
    color: #2B2F38;
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 13px;
}

QFrame#cardFrame {
    background: #FFFFFF;
    border: 1px solid #E6EAF2;
    border-radius: 18px;
}

QFrame#headerFrame {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #FF8A65,
        stop:0.55 #FFB74D,
        stop:1 #FFD54F);
    border-radius: 16px;
}

QLabel#titleLabel {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#subtitleLabel {
    color: rgba(255, 255, 255, 215);
    font-size: 12px;
}

QLabel.sectionTitle {
    color: #2B2F38;
    font-size: 14px;
    font-weight: 700;
}

QFrame#noticeFrame {
    background: #FFF7ED;
    border: 1px solid #FED7AA;
    border-radius: 12px;
}

QLabel.noticeText {
    color: #C2410C;
    font-size: 12px;
    line-height: 18px;
}

QFrame#supportFrame {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 12px;
}

QLabel#supportTitleLabel {
    color: #15803D;
    font-size: 16px;
    font-weight: 700;
}

QLabel#supportDescLabel {
    color: #4B5563;
    font-size: 12px;
}

QLabel#label_image {
    background: #FFFFFF;
    border: 1px solid #DDE7F0;
    border-radius: 12px;
    padding: 6px;
}

QFrame#infoFrame {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel.infoName {
    color: #64748B;
    font-weight: 600;
}

QLabel.infoValue {
    color: #1F2937;
    font-weight: 600;
}

QLabel#label_version,
QLabel#label_qq {
    color: #2563EB;
    font-weight: 600;
}

QLabel#label_version:hover,
QLabel#label_qq:hover {
    color: #F57C00;
}

QLabel#footerLabel {
    color: #94A3B8;
    font-size: 11px;
}</string>
